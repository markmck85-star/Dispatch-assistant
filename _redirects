# Direct-link shortcuts for the state console, e.g. mcrdispatch.net/Georgia
# or mcrdispatch.net/GA -- added 2026-07-27 for phone-homescreen shortcuts.
# Only ever reached for paths that don't match a real file on disk (Netlify
# checks actual files first), so this can't shadow admin/calendar/state/etc.
/:state          /state.html?state=:state    200

# Same shortcut pattern for the watchdog log, added 2026-08-12 --
# mcrdispatch.net/watchdog/GA -> watchdog-log.html?state=GA. Two-segment
# path so it doesn't collide with the single-segment /:state rule above.
/watchdog/:state /watchdog-log.html?state=:state    200

